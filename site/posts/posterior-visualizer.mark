.legend li::before { content: ""; display: inline-block; width: 1.6rem; height: 0.3rem; margin-right: 0.6rem; vertical-align: 0.35rem; background: currentColor; }
.payoff { font-size: 2rem; }
.frac { display: inline-flex; flex-direction: column; align-items: center; vertical-align: middle; margin: 0 0.4rem; }
