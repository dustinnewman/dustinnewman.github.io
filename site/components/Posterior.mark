// Bayesian updating for a coin's bias, one term of Bayes' rule at a time.
// Beta prior x Bernoulli likelihood, so every quantity on screen is exact:
// the evidence is a ratio of Beta functions, not a numerical integral.
var theta = 0.7
var alpha = 1
var beta = 1
var flips = ["H", "T", "H", "H"]
let MAX_FLIPS = 10

let heads = flips.filter(f => f == "H").length
let tails = flips.length - heads
let postA = alpha + heads
let postB = beta + tails

// ---- distributions ----
// Lanczos approximation; plenty accurate for the small parameters here.
fn logGamma(x) {
  if x < 0.5 {
    return Math.log(Math.PI / Math.sin(Math.PI * x)) - logGamma(1 - x)
  }
  let c = [676.5203681218851, -1259.1392167224028, 771.32342877765313, -176.61502916214059,
    12.507343278686905, -0.13857109526572012, 0.0000099843695780195716, 0.00000015056327351493116]
  let y = x - 1
  let t = y + 7.5
  let a = c.reduce((s, ci, i) => s + ci / (y + i + 1), 0.99999999999980993)
  return 0.5 * Math.log(2 * Math.PI) + (y + 0.5) * Math.log(t) - t + Math.log(a)
}
fn logBeta(a, b) = logGamma(a) + logGamma(b) - logGamma(a + b)
fn betaPdf(x, a, b) {
  if x <= 0 || x >= 1 {
    let edge = x <= 0 ? a : b
    return edge < 1 ? 1 / 0 : edge > 1 ? 0 : Math.exp(-logBeta(a, b))
  }
  return Math.exp((a - 1) * Math.log(x) + (b - 1) * Math.log(1 - x) - logBeta(a, b))
}

let priorAt = betaPdf(theta, alpha, beta)
let likelihood = theta ** heads * (1 - theta) ** tails
// p(X) = B(a+h, b+t) / B(a, b), the normalizing area under prior x likelihood.
let evidence = Math.exp(logBeta(postA, postB) - logBeta(alpha, beta))
let posteriorAt = betaPdf(theta, postA, postB)

// ---- plotting (640x190 viewBox, baseline at y=160, top pad 18) ----
let N = 192
let XS = Array.from({length: N + 1}, (_, i) => i / N)
fn sx(x) = 12 + x * 616
fn sy(y, yMax) = 160 - (Number.isFinite(y) ? Math.max(0, Math.min(y / yMax, 1)) : 1) * 142
fn linePath(f, yMax) = XS.map((x, i) => (i == 0 ? "M" : "L") + sx(x).toFixed(1) + " " + sy(f(x), yMax).toFixed(1)).join("")
fn areaPath(f, yMax) = linePath(f, yMax) + "L628 160L12 160Z"
// Peak over the open interval, so an unbounded Beta edge doesn't flatten everything else into the baseline.
fn peak(f) = XS.slice(1, N).reduce((m, x) => (v => Number.isFinite(v) && v > m ? v : m)(f(x)), 0)
fn scaleFor(fns, floor, pad, cap) = Math.max(Math.min(fns.reduce((m, f) => Math.max(m, peak(f)), 0) * pad, cap), floor, 0.000000000001)
fn curve(f, yMax, cls, area, dashed, hidden) = {
  cls, dashed, hidden,
  line: linePath(f, yMax),
  area: area ? areaPath(f, yMax) : null,
  dot: dashed ? null : sy(f(theta), yMax) / 1.9
  }

let priorFn = x => betaPdf(x, alpha, beta)
let posteriorFn = x => betaPdf(x, postA, postB)
let likelihoodFn = x => x ** heads * (1 - x) ** tails
let integrandFn = x => likelihoodFn(x) * priorFn(x)
let priorMax = scaleFor([priorFn], 1.3, 1.25, 14)
let jointMax = scaleFor([priorFn, posteriorFn], 1.3, 1.25, 14)
let integrandMax = scaleFor([integrandFn], 0, 1.25, 14)
// The likelihood is not a density in theta, so it is only ever drawn rescaled to sit alongside the two that are.
let likelihoodPeak = scaleFor([likelihoodFn], 0, 1, 1 / 0)
let scaledLikelihoodFn = x => likelihoodFn(x) / likelihoodPeak * jointMax * 0.82
let marker = sx(theta)

// ---- formatting ----
// Three significant figures even for small probabilities, so the arithmetic on the last line checks out by hand.
fn fmt(v, minDecimals) {
  if !Number.isFinite(v) {
    return "∞"
  }
  if v == 0 {
    return "0"
  }
  if Math.abs(v) >= 0.001 {
    return v.toFixed(Math.min(7, Math.max(minDecimals, 2 - Math.floor(Math.log10(Math.abs(v))))))
  }
  return v.toPrecision(3)
}

fn reset() {
  theta = 0.7
  alpha = 1
  beta = 1
  flips = ["H", "T", "H", "H"]
}

<div class="posterior">
  <div class="rule">
    $$p(\theta \mid X) = \frac{p(X \mid \theta)\, p(\theta)}{p(X)}$$
  </div>

  <section class="panel">
    <h3 class="label centered">$\theta$</h3>
    <p class="caption centered">The bias of the coin — the unknown we want to reason about. Slide it to ask "how well does <em>this</em> value explain the data?"</p>
    <div class="slider-row wide">
      <input type="range" min="0" max="1" step="0.01" value=$theta aria-label="theta" />
      <output class="readout">{theta.toFixed(2)}</output>
    </div>
  </section>

  <section class="panel">
    <h3 class="label centered">$X$</h3>
    <p class="caption centered">The flips we actually saw. Tap a coin to turn it over.</p>
    <div class="boxes-scroll">
      <div class="boxes">
        if flips.length == 0 {
          <span class="no-data">no flips yet</span>
        }
        for f, i in flips key i {
          <button class="box coin" class="heads" if f == "H" onTap={flips[i] = f == "H" ? "T" : "H"} aria-label={"Flip " + (i + 1)}><span class="face">{f}</span></button>
        }
      </div>
    </div>
    <div class="stepper">
      <button class="step" onTap={flips.pop()} disabled={flips.length == 0} aria-label="Remove a flip">−</button>
      <span class="count">{flips.length}</span>
      <button class="step" onTap={flips.push("H")} disabled={flips.length >= MAX_FLIPS} aria-label="Add a flip">+</button>
    </div>
    <p class="tally centered">$h$ = <b class="heads">{heads}</b> {heads == 1 ? "head" : "heads"}, $t$ = <b class="tails">{tails}</b> {tails == 1 ? "tail" : "tails"}</p>
  </section>

  <section class="panel">
    <h3 class="label centered">$p(\theta)$</h3>
    <p class="caption centered">What we believed before seeing a single flip. A $\mathrm{Beta}$ distribution keeps us on $[0, 1]$; at $\alpha$ = $\beta$ = 1 it is flat, which is to say we have no idea.</p>
    <div class="sliders">
      <label class="slider-row"><span class="param">$\alpha$</span><input type="range" min="0.5" max="10" step="0.1" value=$alpha /><output class="readout">{alpha.toFixed(1)}</output></label>
      <label class="slider-row"><span class="param">$\beta$</span><input type="range" min="0.5" max="10" step="0.1" value=$beta /><output class="readout">{beta.toFixed(1)}</output></label>
    </div>
    <Plot curves={[curve(priorFn, priorMax, "prior", true, false, false)]} marker={marker} />
    <p class="value centered">$p(\theta)$ = <b class="prior">{fmt(priorAt, 3)}</b></p>
  </section>

  <section class="panel computed">
    <h3 class="label">$p(X \mid \theta)$</h3>
    <p class="caption">Not something we choose — it is read straight off $\theta$. Each head contributes $\theta$, each tail $(1-\theta)$, and the flips are independent, so they multiply.</p>
    <div class="boxes-scroll">
      <div class="boxes left">
        if flips.length == 0 {
          <span class="no-data">no flips yet</span>
        }
        for f, i in flips key i {
          if i > 0 {
            <span class="times">×</span>
          }
          <div class="box term" class="heads" if f == "H">
            <span class="face">{f}</span>
            if f == "H" {
              <span class="symbol">$\theta$</span>
            } else {
              <span class="symbol">$1-\theta$</span>
            }
            <span class="num like">{(f == "H" ? theta : 1 - theta).toFixed(2)}</span>
          </div>
        }
      </div>
    </div>
    <p class="value">$p(X \mid \theta)$ = $\theta$<sup>{heads}</sup>$(1-\theta)$<sup>{tails}</sup> = <b class="like">{fmt(likelihood, 4)}</b></p>
  </section>

  <section class="panel computed">
    <h3 class="label">$p(X)$</h3>
    <p class="caption">How likely the data was <em>overall</em>, averaging the likelihood over every $\theta$ the prior thought possible. It is the shaded area — one number, the same for every $\theta$, which is why it can only rescale the curve and never reshape it.</p>
    <div class="display">
      $$p(X) = \int_0^1 p(X \mid \theta)\, p(\theta)\, \mathrm{d}\theta$$
    </div>
    <Plot curves={[curve(integrandFn, integrandMax, "joint", true, false, false)]} marker={marker} />
    <p class="value">$p(X)$ = <b>{fmt(evidence, 4)}</b></p>
  </section>

  <section class="panel computed">
    <h3 class="label">$p(\theta \mid X)$</h3>
    <p class="caption">Prior times likelihood, divided by that area. For a $\mathrm{Beta}$ prior the answer is another $\mathrm{Beta}$ — the data just adds to the counts.</p>
    <Plot curves={[
      curve(priorFn, jointMax, "prior", false, false, false),
      curve(scaledLikelihoodFn, jointMax, "like", false, true, flips.length == 0),
      curve(posteriorFn, jointMax, "post", true, false, false)
      ]} marker={marker} />
      <ul class="legend">
      <li class="prior">prior</li>
      <li class="like" class="hidden" if flips.length == 0>likelihood (rescaled)</li>
      <li class="post">posterior</li>
    </ul>
    <div class="display">
      $$p(\theta \mid X) = \mathrm{Beta}(\theta;\, \alpha + h,\, \beta + t)$$
    </div>
    <p class="counts">$\alpha + h$ = {alpha.toFixed(1)} + {heads} = <b class="post">{postA.toFixed(1)}</b><span class="sep">·</span>$\beta + t$ = {beta.toFixed(1)} + {tails} = <b class="post">{postB.toFixed(1)}</b></p>
    <p class="value payoff">$p(\theta \mid X)$ = <span class="frac"><span class="num"><b class="like">{fmt(likelihood, 4)}</b> <span class="op">×</span> <b class="prior">{fmt(priorAt, 3)}</b></span><span class="den">{fmt(evidence, 4)}</span></span> = <b class="post">{fmt(posteriorAt, 3)}</b></p>
  </section>

  <button class="reset" onTap={reset()}>Reset</button>
</div>

<style>
.posterior {
  /* Same convention as the matrix visualizer: red meets blue, makes purple. */
  --red: #e0483e;
  --blue: #4a90d9;
  --purple: color-mix(in srgb, var(--red) 45%, var(--blue));
  --hair: color-mix(in srgb, var(--fg) 30%, transparent);
  margin: 2rem 0;
}
.panel { margin: 0; padding: 3.2rem 0 0; border-top: 1px solid var(--hair); }
.panel + .panel { margin-top: 3.2rem; }
.label { font-size: 2.8rem; margin: 0 0 0.8rem; }
.label::before { content: none; }
.centered { text-align: center; }
.caption { font-size: 1.5rem; line-height: 1.5; margin: 0 auto 1.8rem; max-width: 54rem; opacity: 0.85; }
.panel.computed .caption { margin-left: 0; }
.display, .rule { text-align: center; margin: 1.6rem 0; }
.rule { font-size: 2rem; margin: 0 0 3.2rem; }
.hidden { display: none; }
/* ---- sliders ---- */
.sliders { display: flex; flex-direction: column; gap: 0.6rem; max-width: 42rem; margin: 0 auto 2rem; }
.slider-row { display: grid; grid-template-columns: 2.4rem 1fr 5rem; align-items: center; gap: 1.2rem; }
.slider-row.wide { max-width: 42rem; margin: 0 auto; grid-template-columns: 1fr 5rem; }
.param { text-align: right; font-size: 2rem; }
.readout { font-family: Caveat, cursive; font-size: 2.6rem; color: var(--form-fg); text-align: left; }
input[type="range"] { -webkit-appearance: none; appearance: none; width: 100%; background: transparent; margin: 0; padding: 0; cursor: pointer; }
input[type="range"]::-webkit-slider-runnable-track { height: 1px; background: var(--fg); }
input[type="range"]::-moz-range-track { height: 1px; background: var(--fg); }
input[type="range"]::-webkit-slider-thumb { -webkit-appearance: none; width: 1.6rem; height: 1.6rem; margin-top: -0.8rem; border-radius: 50%; border: 2px solid var(--fg); background: var(--bg); }
input[type="range"]::-moz-range-thumb { width: 1.6rem; height: 1.6rem; border-radius: 50%; border: 2px solid var(--fg); background: var(--bg); }
input[type="range"]:focus-visible::-webkit-slider-thumb { border-color: var(--purple); }
input[type="range"]:focus-visible::-moz-range-thumb { border-color: var(--purple); }
/* ---- boxes: one per flip, in X and again in the likelihood ---- */
.boxes-scroll { overflow-x: auto; padding: 0.4rem 0; }
.boxes { display: flex; align-items: center; gap: 0.5rem; justify-content: center; justify-content: safe center; min-width: min-content; }
.boxes.left { justify-content: flex-start; }
.box, .times { flex: none; }
.box { display: flex; align-items: center; justify-content: center; border: 1px solid var(--fg); background: transparent; color: var(--fg); }
.box .face { display: inline-block; font-family: "Averia Libre", cursive; line-height: 1; }
.box.heads .face { color: var(--red); }
.box:not(.heads) .face { color: var(--blue); }
.no-data { display: inline-flex; align-items: center; min-height: 4.8rem; padding: 0 1.6rem; border: 1px dashed var(--hair); font-style: italic; font-size: 1.4rem; opacity: 0.6; }
.coin { width: 4.8rem; height: 4.8rem; margin: 0; padding: 0; font-size: 2.2rem; cursor: pointer; }
.coin:hover, .coin:focus-visible { outline: none; box-shadow: inset 0 0 0 1px var(--fg); }
.term { flex-direction: column; gap: 0.35rem; width: 5.2rem; padding: 0.6rem 0.2rem; }
.term .face { font-size: 1.8rem; }
.term .symbol { font-size: 1.3rem; line-height: 1; opacity: 0.55; }
.term .num { font-size: 1.6rem; line-height: 1; }
.times { font-size: 1.4rem; opacity: 0.45; }
/* ---- stepper ---- */
.stepper { display: flex; align-items: center; justify-content: center; gap: 1.4rem; margin: 1.4rem 0 0.6rem; }
.step { width: 3.2rem; height: 3.2rem; margin: 0; padding: 0; line-height: 1; font-size: 2rem; font-family: inherit; }
.count { font-family: Caveat, cursive; font-size: 2.6rem; color: var(--form-fg); min-width: 2.4rem; text-align: center; }
.tally { font-size: 1.5rem; margin: 0.6rem 0 0; }
.legend { display: flex; flex-wrap: wrap; justify-content: center; gap: 1.6rem; list-style: none; margin: 0.4rem 0 0; padding: 0; font-size: 1.4rem; }
.legend li::before { content: ""; display: inline-block; width: 1.6rem; height: 0.3rem; margin-right: 0.6rem; vertical-align: 0.35rem; background: currentColor; }
/* ---- readouts ---- */
.value { font-size: 1.8rem; margin: 1.2rem 0 0; }
.value sup { font-size: 1.2rem; }
.counts { font-size: 1.6rem; margin: 0.8rem 0 0; }
.counts .sep { padding: 0 1rem; opacity: 0.5; }
.prior { color: var(--blue); }
.tally .heads { color: var(--red); }
.tally .tails { color: var(--blue); }
.like { color: var(--red); }
.post { color: var(--purple); }
.payoff { font-size: 2rem; margin-top: 1.8rem; }
.frac { display: inline-flex; flex-direction: column; align-items: center; vertical-align: middle; margin: 0 0.4rem; }
.frac .num { padding: 0 0.8rem 0.2rem; border-bottom: 1px solid var(--fg); }
.frac .den { padding: 0.2rem 0.8rem 0; }
.frac .op { padding: 0 0.4rem; opacity: 0.6; }
.reset { display: block; margin: 3.2rem auto 0; font-family: inherit; font-size: 1.6rem; }
@media (max-width: 600px) {
  .label { font-size: 2.4rem; }
  .boxes { gap: 0.35rem; }
  .coin { width: 3.6rem; height: 3.6rem; font-size: 1.8rem; }
  .term { width: 4.8rem; }
  .term .symbol { font-size: 1.2rem; }
  .payoff { font-size: 1.7rem; }
}
</style>
